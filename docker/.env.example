# =============================================================================
# OpenFreeMap Docker Configuration
# =============================================================================
# Copy this to .env in the project root:
#   cp docker/.env.example .env
#
# Then edit the values below before running:
#   docker compose up -d

# Domain/subdomain - set up an A record pointing to your server's IP
DOMAIN_DIRECT=maps.example.com

# Your email for Let's Encrypt certificates
LETSENCRYPT_EMAIL=

# Skip full planet download (true/false) - use true for testing
SKIP_PLANET=false

# Use self-signed certs (true/false)
# Set to true if using VPN, Traefik, or external cert management
SELF_SIGNED_CERTS=false

# --- Advanced (usually not needed) ---

# Round-robin domain for multi-server cert distribution
DOMAIN_ROUNDROBIN=

# Comma-separated list of HTTP host IPs (for load balancer)
HTTP_HOST_LIST=

# Telegram notifications (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
