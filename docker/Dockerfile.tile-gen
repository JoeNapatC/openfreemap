# =============================================================================
# OpenFreeMap Tile Generation Container
# =============================================================================
# Generates map tiles using Planetiler (Java) and packages them into btrfs
# images for upload to Cloudflare R2. Requires --privileged for btrfs operations.
#
# Build: docker build -f docker/Dockerfile.tile-gen -t ofm-tile-gen .
# Run:   docker run --privileged ofm-tile-gen make-tiles monaco
# =============================================================================

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# ---------------------------------------------------------------------------
# 1. Install system packages
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        # Python
        python3 \
        python3-venv \
        python3-pip \
        python3-dev \
        # Build tools (needed for native Python extensions)
        build-essential \
        git \
        # Build dependencies for pycurl
        libcurl4-openssl-dev \
        libssl-dev \
        # Btrfs and archive tools
        btrfs-progs \
        aria2 \
        pigz \
        unzip \
        # Networking and system utilities
        curl \
        wget \
        openssl \
        rsync \
        ca-certificates \
        gnupg2 \
        lsb-release \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# 2. Install Eclipse Temurin Java 24 (from Adoptium repository)
# ---------------------------------------------------------------------------
RUN curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
        | gpg --dearmor -o /etc/apt/keyrings/adoptium.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends temurin-24-jdk \
    && ln -s /usr/lib/jvm/temurin-24-jdk-* /usr/lib/jvm/temurin-24-jdk \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/temurin-24-jdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# ---------------------------------------------------------------------------
# 3. Install rclone (latest stable)
# ---------------------------------------------------------------------------
RUN curl -fsSL https://rclone.org/install.sh | bash

# ---------------------------------------------------------------------------
# 4. Create directory structure
# ---------------------------------------------------------------------------
RUN mkdir -p \
        /data/ofm/config \
        /data/ofm/tile_gen/bin \
        /data/ofm/tile_gen/runs \
        /data/ofm/tile_gen/planetiler \
        /data/ofm/tile_gen/logs

# ---------------------------------------------------------------------------
# 5. Create Python virtual environment and install base packages
# ---------------------------------------------------------------------------
RUN python3 -m venv /data/ofm/venv \
    && /data/ofm/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /data/ofm/venv/bin/pip install --no-cache-dir click pycurl requests

# ---------------------------------------------------------------------------
# 6. Copy and install the tile_gen Python module
# ---------------------------------------------------------------------------
COPY modules/tile_gen/ /data/ofm/tile_gen/bin/
RUN cd /data/ofm/tile_gen/bin \
    && /data/ofm/venv/bin/pip install --no-cache-dir -e . --use-pep517

# ---------------------------------------------------------------------------
# 7. Copy entrypoint
# ---------------------------------------------------------------------------
COPY docker/docker-entrypoint-tile-gen.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

WORKDIR /data/ofm

ENTRYPOINT ["/docker-entrypoint.sh"]
